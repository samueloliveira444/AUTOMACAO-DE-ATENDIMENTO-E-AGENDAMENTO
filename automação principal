      "parameters": {
        "jsCode": "const allFinalMessages = [];\n\n// Função auxiliar para quebrar uma string longa em pedaços por sentença\nfunction chunkBySentence(text, maxLength) {\n    const sentenceRegex = /([.!?]\\s+)/g; // Captura o delimitador (. ! ?) e o espaço seguinte\n    const parts = text.split(sentenceRegex).filter(Boolean); // Divide e mantém os delimitadores\n    \n    const chunks = [];\n    let currentChunk = '';\n\n    for (const part of parts) {\n        // Se a parte for um delimitador, apenas a adiciona ao chunk atual\n        if (part.match(sentenceRegex)) {\n            currentChunk += part;\n            continue;\n        }\n\n        // Se adicionar a nova parte exceder o limite, finaliza o chunk atual\n        if ((currentChunk + part).length > maxLength) {\n            if (currentChunk.trim().length > 0) {\n                chunks.push(currentChunk.trim());\n            }\n            currentChunk = part; // Inicia um novo chunk com a parte atual\n        } else {\n            currentChunk += part;\n        }\n    }\n\n    if (currentChunk.trim().length > 0) {\n        chunks.push(currentChunk.trim());\n    }\n    \n    return chunks;\n}\n\nfor (const item of items) {\n    const text = item.json.output;\n    if (!text) {\n        continue;\n    }\n\n    const delaySeconds = 3;\n    const maxLength = 450; \n\n    // 1. Preservação de Links usando Map para substituição segura.\n    const urlRegex = /(https?:\\/\\/[^\\s )]+)/g;\n    const linkMap = new Map();\n    let linkIndex = 0;\n    \n    const processedText = text.replace(urlRegex, (match) => {\n        const marker = `__LINK_${linkIndex++}__`;\n        linkMap.set(marker, match);\n        return marker;\n    });\n\n    const paragraphs = processedText.split('\\n').filter(p => p.trim().length > 0);\n    const messageChunks = [];\n    let currentChunk = '';\n\n    for (const paragraph of paragraphs) {\n        // Se o parágrafo for muito longo, quebra por sentença\n        if (paragraph.length > maxLength) {\n            // Finaliza o chunk atual antes de inserir os sub-chunks do parágrafo\n            if (currentChunk.length > 0) {\n                messageChunks.push(currentChunk.trim());\n                currentChunk = '';\n            }\n            \n            const subChunks = chunkBySentence(paragraph, maxLength);\n            messageChunks.push(...subChunks);\n            continue;\n        }\n\n        // Tenta adicionar o parágrafo ao chunk existente\n        const nextChunk = currentChunk ? currentChunk + '\\n' + paragraph : paragraph;\n        \n        if (nextChunk.length > maxLength) {\n            // Se o parágrafo não couber, envia o chunk atual e inicia um novo\n            if (currentChunk.length > 0) {\n                messageChunks.push(currentChunk.trim());\n            }\n            currentChunk = paragraph;\n        } else {\n            // Adiciona o parágrafo ao chunk\n            currentChunk = nextChunk;\n        }\n    }\n\n    // Adiciona o último chunk\n    if (currentChunk.length > 0) {\n        messageChunks.push(currentChunk.trim());\n    }\n\n    // 4. Substitui os marcadores de volta pelos links e cria os objetos de mensagem.\n    const finalMessages = messageChunks.map(msg => {\n        let restored = msg;\n        linkMap.forEach((link, marker) => {\n            restored = restored.replace(marker, link);\n        });\n        \n        return {\n            json: {\n                ...item.json,\n                message: restored,\n                delay: delaySeconds\n            }\n        };\n    });\n\n    allFinalMessages.push(...finalMessages);\n}\n\nreturn allFinalMessages;\n"
