      "parameters": {
        "jsCode": "const items = $input.all();\nconst resultadoFinal = [];\n\nfor (const item of items) {\n  const dadosApi = item.json;\n\n  const processarDia = (dia) => {\n    if (!dia.horario || !Array.isArray(dia.horario)) return null;\n\n    // 1. Achata a lista original\n    const todosHorariosRaw = dia.horario.flat();\n\n    const listaFiltrada = [];\n    let ultimoHorarioRegistrado = \"00:00\"; // Marcador para comparar a progressão do tempo\n\n    for (const h of todosHorariosRaw) {\n      // Validação básica de disponibilidade e formato\n      if (h.id_agendamento === 0 && h.horario && /^\\d{2}:\\d{2}/.test(h.horario)) {\n        \n        const horaAtual = h.horario.substring(0, 5);\n\n        // REGRA DE OURO: Se a hora atual for MENOR que a última que pegamos,\n        // significa que a lista de \"hoje\" acabou e começou a de outro dia/turno.\n        if (horaAtual < ultimoHorarioRegistrado) {\n          break; // PARA o loop completamente e não pega mais nada\n        }\n\n        // Se a hora for igual, é um duplicado, apenas ignoramos e continuamos\n        if (horaAtual === ultimoHorarioRegistrado) {\n          continue;\n        }\n\n        // REGRA: Limite máximo do expediente (19:40)\n        if (horaAtual <= \"19:40\") {\n          listaFiltrada.push(horaAtual);\n          ultimoHorarioRegistrado = horaAtual; // Atualiza o marcador para a próxima comparação\n        }\n      }\n    }\n\n    return {\n      total_encontrado: listaFiltrada.length,\n      data_processada: \"2026-02-25\", // Ideal extrair da API se possível\n      is_hoje: false,\n      horarios_disponiveis: listaFiltrada\n    };\n  };\n\n  if (Array.isArray(dadosApi)) {\n    dadosApi.forEach(dia => {\n      const p = processarDia(dia);\n      if (p) resultadoFinal.push({ json: p });\n    });\n  } else {\n    const p = processarDia(dadosApi);\n    if (p) resultadoFinal.push({ json: p });\n  }\n}\n\nreturn resultadoFinal;"
      },
