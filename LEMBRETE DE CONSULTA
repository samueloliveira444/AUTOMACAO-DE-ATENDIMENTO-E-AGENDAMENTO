        "jsCode": "const results = [];\n// Pega a hora atual no fuso de SP\nconst now = new Date(new Date().toLocaleString(\"en-US\", {timeZone: \"America/Sao_Paulo\"}));\n\n// --- CORREÇÃO DO ERRO DE ITEM PAIRING ---\n// Trocamos .item.json por .last().json para evitar o erro de \"Vários itens correspondentes\"\nconst context = $('🔄 Loop (1 por vez)1').last().json; \nconst apiResponse = items[0].json;\n\n// PALAVRAS PARA IGNORAR (Blacklist)\nconst IGNORED_TERMS = [\n    \"FERIADO\", \"ALMOÇO\", \"ALMOCO\", \"BLOQUEIO\", \"REUNIÃO\", \"REUNIAO\", \n    \"SEM EXPEDIENTE\", \"FECHADO\", \"NÃO ATEN\", \"NAO ATEN\", \"VAZIO\"\n];\n\n// INTERVALO DE FUNCIONAMENTO (09:00 - 19:45)\nconst START_MINUTES = 9 * 60; \nconst END_MINUTES = 19 * 60 + 45;\n\nif (!apiResponse || !apiResponse.horario) {\n  return [{ json: { enviar: false, reason: \"Sem agenda/horários\" } }];\n}\n\n// --- LOGICA PARA PEGAR APENAS O DIA ATUAL DA REQUISIÇÃO ---\nlet slots = [];\nif (Array.isArray(apiResponse.horario)) {\n    // Se a API retornar vários dias, pegamos apenas o primeiro [0]\n    // pois o Loop já está filtrando o dia correto na chamada da API\n    if (apiResponse.horario.length > 0 && Array.isArray(apiResponse.horario[0])) {\n        slots = apiResponse.horario[0];\n    } else {\n        slots = apiResponse.horario;\n    }\n}\n\nfor (const slot of slots) {\n  // Ignora se não tiver ID de paciente ou se for 0\n  if (!slot.id_paciente || slot.id_paciente === 0) continue;\n\n  const rawH = slot.horario || \"\";\n  if (!rawH.includes(':') || rawH.length < 5) continue;\n\n  const hora = rawH.substring(0, 5).trim();\n  let pacienteNomeRaw = rawH.substring(6).trim();\n\n  // 1. Filtro de Expediente\n  const [h, m] = hora.split(':').map(Number);\n  const currentSlotMinutes = h * 60 + m;\n  if (currentSlotMinutes < START_MINUTES || currentSlotMinutes > END_MINUTES) continue;\n\n  // 2. Filtro de Blacklist de nomes\n  if (!pacienteNomeRaw || pacienteNomeRaw.length < 2) continue;\n  const nomeUpper = pacienteNomeRaw.toUpperCase();\n  if (IGNORED_TERMS.some(term => nomeUpper.includes(term))) continue;\n\n  // 3. Cálculo da data correta usando a data que veio do Loop\n  const apptDate = new Date(`${context.dateToCheck} ${hora}:00`);\n  const diff = (apptDate - now) / (1000 * 60 * 60);\n\n  let tipo = null;\n  let quando_texto = \"hoje\";\n\n  if (diff > 23.1 && diff <= 24.9) { \n     tipo = '24h';\n     quando_texto = \"amanhã\";\n  } else if (diff > 11.1 && diff <= 12.9) {\n     tipo = '12h';\n     quando_texto = \"amanhã\";\n  } else if (diff > 1.5 && diff <= 2.5) {\n     tipo = '2h';\n     quando_texto = \"hoje\";\n  }\n\n  // Ignora consultas que já passaram\n  if (diff < 0) continue; \n\n  const currentHour = now.getHours();\n  const isMadrugada = currentHour >= 22 || currentHour < 7;\n\n  if (tipo && !isMadrugada) {\n    results.push({\n      json: { \n        id_log: `${slot.id_paciente}_${context.dateToCheck}_${tipo}`, \n        paciente: { nome: pacienteNomeRaw },\n        id_paciente: slot.id_paciente,\n        dentista: context.dentistName, \n        hora, \n        tipo,\n        quando_texto, \n        enviar: true,\n        dateToCheck: context.dateToCheck \n      }\n    });\n  }\n}\n\n// Se não houver nada para enviar, retorna um aviso informativo\nif (results.length === 0) {\n    return [{ json: { enviar: false, reason: \"Nenhum alerta válido encontrado\" } }];\n}\n\nreturn results;"
      },
