      "parameters": {
        "jsCode": "// 1. Lista de IDs dos profissionais ativos fornecida por você\nconst IDS_PERMITIDOS = [\n  \"4471\", \"7038\", \"10183\", \"7081\", \"9369\", \n  \"9942\", \"9480\", \"9418\", \"6498\", \"9729\", \"4469\"\n];\n\nconst input = items[0].json;\nlet dentists = [];\n\n// Trata a entrada (se é array direto ou objeto com chave de array)\nif (Array.isArray(input)) { \n  dentists = input; \n} else { \n  for (let key in input) { \n    if (Array.isArray(input[key])) { dentists = input[key]; break; } \n  } \n}\n\nconst requests = [];\n\n// Função para pegar data no fuso de SP\nfunction getBrDate(days) {\n  const d = new Date();\n  const br = new Date(d.toLocaleString(\"en-US\", {timeZone: \"America/Sao_Paulo\"}));\n  br.setDate(br.getDate() + days);\n  return br.toISOString().split('T')[0];\n}\n\nconst today = getBrDate(0);\nconst tomorrow = getBrDate(1);\n\ndentists.forEach(d => {\n  // Tenta capturar o ID de várias formas comuns em APIs\n  const rawId = d.id || d.ID || d.codigo || d.id_agenda || d.id_profissional;\n  const idStr = rawId ? rawId.toString() : null;\n  const nome = d.nome || d.Nome || d.nome_profissional || \"Dentista\";\n\n  // 2. FILTRO: Só processa se o ID estiver na nossa lista de permitidos\n  if (idStr && IDS_PERMITIDOS.includes(idStr)) {\n    // Gera entrada para hoje\n    requests.push({ \n      json: { \n        dentistId: idStr, \n        dentistName: nome, \n        dateToCheck: today \n      } \n    });\n    // Gera entrada para amanhã\n    requests.push({ \n      json: { \n        dentistId: idStr, \n        dentistName: nome, \n        dateToCheck: tomorrow \n      } \n    });\n  }\n});\n\nreturn requests;"
