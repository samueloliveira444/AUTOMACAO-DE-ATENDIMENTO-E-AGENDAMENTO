        "mode": "runOnceForEachItem",
        "jsCode": "// 1. Recupera o Static Data do n8n para manter a memória dos alertas\nconst staticData = $getWorkflowStaticData('global');\n\n// 2. Inicializa o estado dos alertas se for a primeira vez rodando\nif (staticData.alerted_3 === undefined) staticData.alerted_3 = false;\nif (staticData.alerted_1 === undefined) staticData.alerted_1 = false;\n\n// 3. Captura os dados vindos do nó HTTP anterior\nconst data = item.json.data;\n\nif (!data || data.total_credits === undefined || data.total_usage === undefined) {\n    throw new Error('Resposta inválida da API OpenRouter.');\n}\n\n// 4. Calcula o saldo real disponível\nconst saldo = parseFloat((data.total_credits - data.total_usage).toFixed(2));\nlet alertType = 'none';\n\n// 5. Lógica de Reset: Se você recarregar a conta, as travas caem\nif (saldo >= 3) staticData.alerted_3 = false;\nif (saldo >= 1) staticData.alerted_1 = false;\n\n// 6. Lógica dos Gatilhos de Alerta ($1 e $3)\nif (saldo < 1) {\n    if (!staticData.alerted_1) {\n        alertType = 'critico_1';\n        staticData.alerted_1 = true;\n        staticData.alerted_3 = true; // Evita disparar o de $3 se cair direto de uma vez\n    }\n} else if (saldo < 3) {\n    if (!staticData.alerted_3) {\n        alertType = 'alerta_3';\n        staticData.alerted_3 = true;\n        staticData.alerted_1 = false; // Deixa o de $1 pronto para a próxima queda\n    }\n}\n\n// 7. Retorna o saldo e o tipo de alerta para os próximos nós\nreturn { \n    json: { \n        saldo: saldo, \n        alertType: alertType \n    } \n}; "
