    {
      "parameters": {
        "jsCode": "// Obtém o input do nó anterior (Listar Profissionais)\nconst input = items[0].json;\nlet listaBruta = [];\n\n// 1. TENTATIVA DE LOCALIZAR A LISTA (Resiliência)\n// Verifica se o input já é um array, ou se está dentro de propriedades comuns como 'agendas', 'd', 'result'\nif (Array.isArray(input)) {\n    listaBruta = input;\n} else if (input.agendas && Array.isArray(input.agendas)) {\n    listaBruta = input.agendas;\n} else if (input.d && Array.isArray(input.d)) {\n    listaBruta = input.d;\n} else if (input.ListaAgendas && Array.isArray(input.ListaAgendas)) {\n    listaBruta = input.ListaAgendas;\n} else {\n    // Se o HTTP Request separou os itens em vários inputs no n8n\n    if (items.length > 1) {\n        listaBruta = items.map(item => item.json);\n    }\n}\n\n// Se ainda estiver vazia, tenta achar qualquer array dentro do objeto\nif (listaBruta.length === 0) {\n    for (const key in input) {\n        if (Array.isArray(input[key])) {\n            listaBruta = input[key];\n            break;\n        }\n    }\n}\n\n// 2. FUNÇÃO DE NORMALIZAÇÃO (Mantendo sua lógica original)\nconst normalizar = (texto) => {\n    if (!texto) return '';\n    return texto\n        .toLowerCase()\n        .normalize('NFD')\n        .replace(/[\\u0300-\\u036f]/g, '')\n        .replace(/^(dr|dra|doutor|doutora)\\.?\\s+/g, '') // Remove prefixos\n        .replace(/[^a-z\\s]/g, '') // Remove caracteres especiais\n        .replace(/\\s+/g, ' ') // Remove espaços duplos\n        .trim();\n};\n\n// 3. CRIAÇÃO DO MAPA\nconst mapa = {};\nconst debugInfo = [];\n\nfor (const item of listaBruta) {\n    // Tenta encontrar o ID e o NOME olhando variações comuns de chaves da Dentalis/APIs\n    const id = item.agendaId || item.codigo || item.Codigo || item.id || item.ID || item.Id;\n    const nome = item.agendaNome || item.nome || item.Nome || item.Name || item.profissional;\n\n    if (id && nome) {\n        const nomeNormalizado = normalizar(nome);\n        \n        // Mapeia o nome completo\n        mapa[nomeNormalizado] = id;\n\n        // Opcional: Mapeia também o primeiro nome se for único (ex: \"tiago\" acha \"tiago reis\")\n        const primeiroNome = nomeNormalizado.split(' ')[0];\n        if (primeiroNome && primeiroNome !== nomeNormalizado && !mapa[primeiroNome]) {\n             mapa[primeiroNome] = id;\n        }\n\n        debugInfo.push(`${nome} (ID: ${id}) -> Normalizado: ${nomeNormalizado}`);\n    }\n}\n\n// Validação de Segurança\nif (Object.keys(mapa).length === 0) {\n    // Se não achou nada, retorna um erro amigável ou um mapa vazio\n    // Isso evita que o fluxo quebre, mas avisa no debug\n    return [{\n        json: {\n            MAPA_AGENDAS_RESOLVIDO: {},\n            erro: \"Nenhuma agenda encontrada. Verifique o output do nó 'Listar Profissionais'.\",\n            input_recebido: input\n        }\n    }];\n}\n\n// 4. RETORNO PARA O AGENTE\nreturn [{\n    json: {\n        MAPA_AGENDAS_RESOLVIDO: mapa,\n        _debug_lista_processada: debugInfo // Útil para você conferir se deu certo\n    }\n}];"
      },
